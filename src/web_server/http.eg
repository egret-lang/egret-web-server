module web_server;

use web_server;
use aio.tcp;
use aio.tls;
use strconv;
use strings;
use std;

// In-memory HTTP response representation. Rendering is kept here so all
// handlers emit a consistent status line, content headers, and connection mode.
class HttpResponse {
    // Numeric HTTP status code.
    var code: Int;
    // Value for the Content-Type header.
    var content_type: String;
    // Response body bytes.
    var body: String;
    // Whether the response should keep the client connection open.
    var keep_alive: Bool;
    // Optional raw headers appended before Content-Length.
    var extra_headers: String;

    func init(self: web_server.HttpResponse, code: Int, content_type: String, body: String, keep_alive: Bool = false, extra_headers: String = "") -> Void {
        self.code = code;
        self.content_type = content_type;
        self.body = body;
        self.keep_alive = keep_alive;
        self.extra_headers = extra_headers;
    }

    // Maps supported status codes to reason phrases.
    func reason(self: web_server.HttpResponse) -> String {
        return match self.code {
            301 => "Moved Permanently",
            400 => "Bad Request",
            404 => "Not Found",
            413 => "Payload Too Large",
            500 => "Internal Server Error",
            502 => "Bad Gateway",
            _ => "OK",
        };
    }

    // Serializes the keep-alive decision into the Connection header.
    func connection_header(self: web_server.HttpResponse) -> String {
        return match self.keep_alive {
            true => "\r\nConnection: keep-alive\r\n\r\n",
            _ => "\r\nConnection: close\r\n\r\n",
        };
    }

    // Renders the full HTTP/1.1 response message.
    func render(self: web_server.HttpResponse) -> String {
        return "HTTP/1.1 " + strconv.itoa(self.code) + " " + self.reason()
        + "\r\nServer: egret-web-server\r\nContent-Type: " + self.content_type
        + "\r\nContent-Length: " + strconv.itoa(len(self.body))
        + "\r\nStrict-Transport-Security: max-age=31536000; includeSubDomains"
        + "\r\nContent-Security-Policy: upgrade-insecure-requests; block-all-mixed-content"
        + "\r\nX-Content-Type-Options: nosniff"
        + "\r\nReferrer-Policy: strict-origin-when-cross-origin"
        + self.extra_headers
        + self.connection_header() + self.body;
    }
}

// Lightweight request wrapper. It stores the raw request and delegates parsing
// to HttpRequestParser so handlers can ask for method, path, headers, and body.
class HttpRequest {
    // Full request bytes as received from the client.
    var raw: String;
    // Stateless parser shared by all accessors.
    var parser: web_server.HttpRequestParser;

    func init(self: web_server.HttpRequest, raw: String) -> Void {
        self.raw = raw;
        self.parser = new web_server.HttpRequestParser();
    }

    // Path without query string.
    func path(self: web_server.HttpRequest) -> String {
        return self.parser.path(self.raw);
    }

    // Original request target from the request line.
    func target(self: web_server.HttpRequest) -> String {
        return self.parser.target(self.raw);
    }

    func method(self: web_server.HttpRequest) -> String {
        return self.parser.method(self.raw);
    }

    func protocol(self: web_server.HttpRequest) -> String {
        return self.parser.protocol(self.raw);
    }

    func query(self: web_server.HttpRequest) -> String {
        return self.parser.query(self.raw);
    }

    func query_string(self: web_server.HttpRequest) -> String {
        return self.parser.query_string(self.raw);
    }

    func header(self: web_server.HttpRequest, key_lc: String) -> String {
        return self.parser.header(self.raw, key_lc);
    }

    func body(self: web_server.HttpRequest) -> String {
        return self.parser.body(self.raw);
    }

    func keep_alive(self: web_server.HttpRequest) -> Bool {
        return self.parser.keep_alive(self.raw);
    }

    func host(self: web_server.HttpRequest) -> String {
        return self.parser.host(self.raw);
    }

    // Convenience wrapper for gzip negotiation.
    func accepts_gzip(self: web_server.HttpRequest) -> Bool {
        return (new web_server.GzipRequestCapabilities()).accepts_gzip(self.raw);
    }
}

// Transport interface implemented by TCP and TLS connection adapters.
norm HttpConn<T> {
    async func http_conn_recv(self: T, max_bytes: Int, timeout_ms: Int) -> String, ErrCode;
    async func http_conn_send(self: T, data: String, timeout_ms: Int) -> Int, ErrCode;
    func http_conn_close(self: T) -> Void;
}

// Plain TCP implementation of HttpConn.
class TcpHttpConn {
    // Socket file descriptor owned by the connection wrapper.
    var fd: Int;

    func init(self: web_server.TcpHttpConn, fd: Int) -> Void {
        self.fd = fd;
    }
}

norm impl HttpConn<web_server.TcpHttpConn> {
    async func http_conn_recv(self: web_server.TcpHttpConn, max_bytes: Int, timeout_ms: Int) -> String, ErrCode {
        let chunk, err = await aio.tcp.recv(self.fd, max_bytes, timeout_ms);
        return chunk, err;
    }

    async func http_conn_send(self: web_server.TcpHttpConn, data: String, timeout_ms: Int) -> Int, ErrCode {
        let n, err = await aio.tcp.send(self.fd, data, timeout_ms);
        return n, err;
    }

    func http_conn_close(self: web_server.TcpHttpConn) -> Void {
        _ = aio.tcp.close(self.fd);
    }
}

// TLS implementation of HttpConn.
class TlsHttpConn {
    // TLS socket file descriptor owned by the connection wrapper.
    var fd: Int;

    func init(self: web_server.TlsHttpConn, fd: Int) -> Void {
        self.fd = fd;
    }
}

norm impl HttpConn<web_server.TlsHttpConn> {
    async func http_conn_recv(self: web_server.TlsHttpConn, max_bytes: Int, timeout_ms: Int) -> String, ErrCode {
        let chunk, err = await aio.tls.recv(self.fd, max_bytes, timeout_ms);
        return chunk, err;
    }

    async func http_conn_send(self: web_server.TlsHttpConn, data: String, timeout_ms: Int) -> Int, ErrCode {
        let n, err = await aio.tls.send(self.fd, data, timeout_ms);
        return n, err;
    }

    func http_conn_close(self: web_server.TlsHttpConn) -> Void {
        _ = aio.tls.close(self.fd);
    }
}

// Runtime transport selector for client or upstream HTTP I/O. It hides whether
// the fd is plain TCP or TLS and applies the configured timeout everywhere.
class HttpTransport {
    // Socket/TLS file descriptor.
    var fd: Int;
    // True when fd must be accessed through aio.tls.
    var is_tls: Bool;
    // Per-operation timeout in milliseconds.
    var timeout_ms: Int;

    func init(self: web_server.HttpTransport, fd: Int, is_tls: Bool = false, timeout_ms: Int = DEFAULT_KEEPALIVE_TIMEOUT_MS) -> Void {
        self.fd = fd;
        self.is_tls = is_tls;
        self.timeout_ms = timeout_ms;
    }

    // Receives a complete HTTP request, including fixed-length or chunked body.
    async func recv_request(self: web_server.HttpTransport, max_total: Int) -> String {
        if self.is_tls {
            let tls_stream = new web_server.HttpConnStream<web_server.TlsHttpConn>(new web_server.TlsHttpConn(self.fd));
            return await tls_stream.recv_request(max_total, self.timeout_ms);
        }
        let tcp_stream = new web_server.HttpConnStream<web_server.TcpHttpConn>(new web_server.TcpHttpConn(self.fd));
        return await tcp_stream.recv_request(max_total, self.timeout_ms);
    }

    // Sends the complete response or proxied request.
    async func send_all(self: web_server.HttpTransport, data: String) -> Int {
        if self.is_tls {
            let tls_stream = new web_server.HttpConnStream<web_server.TlsHttpConn>(new web_server.TlsHttpConn(self.fd));
            return await tls_stream.send_all(data, self.timeout_ms);
        }
        let tcp_stream = new web_server.HttpConnStream<web_server.TcpHttpConn>(new web_server.TcpHttpConn(self.fd));
        return await tcp_stream.send_all(data, self.timeout_ms);
    }

    // Reads until EOF or max_total, used for upstream proxy responses.
    async func recv_all(self: web_server.HttpTransport, max_total: Int) -> String {
        if self.is_tls {
            let tls_stream = new web_server.HttpConnStream<web_server.TlsHttpConn>(new web_server.TlsHttpConn(self.fd));
            return await tls_stream.recv_all(max_total, self.timeout_ms);
        }
        let tcp_stream = new web_server.HttpConnStream<web_server.TcpHttpConn>(new web_server.TcpHttpConn(self.fd));
        return await tcp_stream.recv_all(max_total, self.timeout_ms);
    }

    // Closes the selected transport.
    func close(self: web_server.HttpTransport) -> Void {
        if self.is_tls {
            let tls_stream = new web_server.HttpConnStream<web_server.TlsHttpConn>(new web_server.TlsHttpConn(self.fd));
            _ = tls_stream.close();
        } else {
            let tcp_stream = new web_server.HttpConnStream<web_server.TcpHttpConn>(new web_server.TcpHttpConn(self.fd));
            _ = tcp_stream.close();
        }
    }
}

// Factory for common response shapes used across static, proxy, FastCGI, and
// error paths.
class HttpResponseFactory {
    func init(self: web_server.HttpResponseFactory) -> Void {
    }

    func response_conn(self: web_server.HttpResponseFactory, code: Int, content_type: String, body: String, keep_alive: Bool) -> String {
        return self.response_extra(code, content_type, body, keep_alive, "");
    }

    func response_extra(self: web_server.HttpResponseFactory, code: Int, content_type: String, body: String, keep_alive: Bool, extra_headers: String) -> String {
        let resp = new web_server.HttpResponse(code, content_type, body, keep_alive, extra_headers);
        return resp.render();
    }

    func redirect_response(self: web_server.HttpResponseFactory, location: String, keep_alive: Bool) -> String {
        return self.response_extra(301, "text/plain; charset=utf-8", "Moved Permanently", keep_alive, "\r\nLocation: " + location);
    }

    func response(self: web_server.HttpResponseFactory, code: Int, content_type: String, body: String) -> String {
        return self.response_conn(code, content_type, body, false);
    }
}

// Hand-written HTTP/1.1 parser for request lines, headers, and bodies.
class HttpRequestParser {
    func init(self: web_server.HttpRequestParser) -> Void {
    }

    // Extracts the path component and strips any query string.
    func path(self: web_server.HttpRequestParser, req: String) -> String {
        let method_end = strings.find_substr(req, " ");
        if method_end < 0 {
            return "/";
        }
        let rest = substr(req, method_end + 1, len(req) - (method_end + 1));
        let target_end = strings.find_substr(rest, " ");
        if target_end < 0 {
            return "/";
        }
        return (new web_server.ServerUtil()).clean_path(substr(rest, 0, target_end));
    }

    // Extracts the raw request target.
    func target(self: web_server.HttpRequestParser, req: String) -> String {
        let method_end = strings.find_substr(req, " ");
        if method_end < 0 {
            return "/";
        }
        let rest = substr(req, method_end + 1, len(req) - (method_end + 1));
        let target_end = strings.find_substr(rest, " ");
        if target_end < 0 {
            return "/";
        }
        return substr(rest, 0, target_end);
    }

    // Extracts the request method.
    func method(self: web_server.HttpRequestParser, req: String) -> String {
        let method_end = strings.find_substr(req, " ");
        if method_end < 0 {
            return "GET";
        }
        return substr(req, 0, method_end);
    }

    // Extracts the protocol token from the request line.
    func protocol(self: web_server.HttpRequestParser, req: String) -> String {
        let first_end = strings.find_substr(req, "\r\n");
        let first = req;
        if first_end >= 0 {
            first = substr(req, 0, first_end);
        }
        let p = strings.last_index(first, " ");
        if p < 0 {
            return "HTTP/1.1";
        }
        return substr(first, p + 1, len(first) - (p + 1));
    }

    // Extracts the query including the leading question mark.
    func query(self: web_server.HttpRequestParser, req: String) -> String {
        let method_end = strings.find_substr(req, " ");
        if method_end < 0 {
            return "";
        }
        let rest = substr(req, method_end + 1, len(req) - (method_end + 1));
        let target_end = strings.find_substr(rest, " ");
        if target_end < 0 {
            return "";
        }
        let target = substr(rest, 0, target_end);
        let q = strings.find_substr(target, "?");
        if q < 0 {
            return "";
        }
        return substr(target, q, len(target) - q);
    }

    // Extracts the query without the leading question mark.
    func query_string(self: web_server.HttpRequestParser, req: String) -> String {
        let q = self.query(req);
        if len(q) == 0 {
            return "";
        }
        return substr(q, 1, len(q) - 1);
    }

    // Case-insensitive header lookup. key_lc must be lowercase.
    func header(self: web_server.HttpRequestParser, req: String, key_lc: String) -> String {
        let marker = "\r\n" + key_lc + ":";
        let p = strings.find_substr_ascii_case(req, marker);
        if p < 0 {
            return "";
        }
        let start = p + len(marker);
        let rest = substr(req, start, len(req) - start);
        let e = strings.find_substr(rest, "\r\n");
        if e < 0 {
            return strings.trim_space(rest);
        }
        return strings.trim_space(substr(rest, 0, e));
    }

    // Parses Content-Length and returns zero when absent or invalid.
    func content_length(self: web_server.HttpRequestParser, req: String) -> Int {
        return (new web_server.ServerUtil()).atoi_or(self.header(req, "content-length"), 0);
    }

    // Detects Transfer-Encoding: chunked.
    func is_chunked(self: web_server.HttpRequestParser, req: String) -> Bool {
        let te = strings.to_lower_ascii(self.header(req, "transfer-encoding"));
        return strings.contains(te, "chunked");
    }

    // Returns bytes after the CRLFCRLF header separator.
    func raw_body(self: web_server.HttpRequestParser, req: String) -> String {
        let sep = strings.find_substr(req, "\r\n\r\n");
        if sep < 0 {
            return "";
        }
        return substr(req, sep + 4, len(req) - (sep + 4));
    }

    // Checks whether the buffered chunked body contains the terminating
    // zero-size chunk and its trailing CRLF.
    func chunked_body_complete(self: web_server.HttpRequestParser, body: String) -> Bool {
        let pos = 0;
        loop pos < len(body) {
            let nl = strings.find_substr_from(body, "\r\n", pos);
            if nl < 0 {
                return false;
            }
            let sz = strings.parse_hex_int(substr(body, pos, nl - pos));
            pos = nl + 2;
            if sz == 0 {
                if pos + 2 <= len(body) && substr(body, pos, 2) == "\r\n" {
                    return true;
                }
                return strings.find_substr_from(body, "\r\n\r\n", pos) >= 0;
            }
            if pos + sz + 2 > len(body) {
                return false;
            }
            pos = pos + sz;
            if substr(body, pos, 2) != "\r\n" {
                return false;
            }
            pos += 2;
        }
        return false;
    }

    // Decodes a chunked request body into contiguous payload bytes.
    func decode_chunked_body(self: web_server.HttpRequestParser, body: String) -> String {
        let out = "";
        let pos = 0;
        loop pos < len(body) {
            let nl = strings.find_substr_from(body, "\r\n", pos);
            if nl < 0 {
                return out;
            }
            let sz = strings.parse_hex_int(substr(body, pos, nl - pos));
            pos = nl + 2;
            if sz == 0 {
                return out;
            }
            if pos + sz > len(body) {
                return out;
            }
            out += substr(body, pos, sz);
            pos += sz;
            if pos + 2 <= len(body) && substr(body, pos, 2) == "\r\n" {
                pos += 2;
            }
        }
        return out;
    }

    // Returns the decoded body for chunked requests, otherwise the raw body.
    func body(self: web_server.HttpRequestParser, req: String) -> String {
        let body = self.raw_body(req);
        if self.is_chunked(req) {
            return self.decode_chunked_body(body);
        }
        return body;
    }

    // Implements HTTP/1.1 keep-alive rules plus explicit Connection headers.
    func keep_alive(self: web_server.HttpRequestParser, req: String) -> Bool {
        if strings.find_substr_ascii_case(req, "\r\nconnection: close") >= 0 {
            return false;
        }
        if strings.find_substr_ascii_case(req, " http/1.0") >= 0 {
            return strings.find_substr_ascii_case(req, "\r\nconnection: keep-alive") >= 0;
        }
        return true;
    }

    // Normalizes Host for virtual-host matching by trimming, lowercasing, and
    // removing a non-IPv6 port suffix.
    func normalize_host_name(self: web_server.HttpRequestParser, host: String) -> String {
        let h = strings.to_lower_ascii(strings.trim_space(host));
        if len(h) == 0 {
            return "";
        }
        if (new web_server.ServerUtil()).starts_with(h, "[") {
            return h;
        }
        let p = strings.last_index(h, ":");
        if p > 0 {
            return substr(h, 0, p);
        }
        return h;
    }

    // Extracts and normalizes the Host header.
    func host(self: web_server.HttpRequestParser, req: String) -> String {
        let marker = "\r\nhost:";
        let p = strings.find_substr_ascii_case(req, marker);
        if p < 0 {
            return "";
        }
        let start = p + len(marker);
        let rest = substr(req, start, len(req) - start);
        let e = strings.find_substr(rest, "\r\n");
        if e < 0 {
            return self.normalize_host_name(rest);
        }
        return self.normalize_host_name(substr(rest, 0, e));
    }
}

// Generic stream helper over HttpConn. It owns no socket itself; it only loops
// reads/writes until a full request or response has been transferred.
class HttpConnStream<T: web_server.HttpConn> {
    // Underlying TCP or TLS adapter.
    var conn: T;

    func init(self: web_server.HttpConnStream<T>, conn: T) -> Void {
        self.conn = conn;
    }

    // Receives headers first, then reads either chunked body or Content-Length
    // bytes without exceeding max_total.
    async func recv_request(self: web_server.HttpConnStream<T>, max_total: Int, timeout_ms: Int) -> String {
        let parser = new web_server.HttpRequestParser();
        let req = await self.recv_until("\r\n\r\n", max_total, timeout_ms);
        let sep = strings.find_substr(req, "\r\n\r\n");
        if sep < 0 {
            return req;
        }
        if parser.is_chunked(req) {
            loop !parser.chunked_body_complete(parser.raw_body(req)) {
                if len(req) >= max_total {
                    return req;
                }
                let chunk, err = await web_server.HttpConn<T>.http_conn_recv(self.conn, 4096, timeout_ms);
                if err != OK && err != ERR_EOF {
                    return req;
                }
                if len(chunk) == 0 {
                    return req;
                }
                req += chunk;
            }
            return req;
        }
        let content_len = parser.content_length(req);
        if content_len <= 0 {
            return req;
        }
        let body_start = sep + 4;
        loop len(req) < body_start + content_len {
            if len(req) >= max_total {
                return req;
            }
            let need = body_start + content_len - len(req);
            let want = need;
            if want > 4096 {
                want = 4096;
            }
            let chunk, err = await web_server.HttpConn<T>.http_conn_recv(self.conn, want, timeout_ms);
            if err != OK && err != ERR_EOF {
                return req;
            }
            if len(chunk) == 0 {
                return req;
            }
            req += chunk;
        }
        return req;
    }

    // Reads until a marker is present, EOF happens, or the maximum size is hit.
    async func recv_until(self: web_server.HttpConnStream<T>, pat: String, max_total: Int, timeout_ms: Int) -> String {
        let buf = "";
        let done = false;
        loop !done {
            if len(buf) >= max_total {
                done = true;
            } else if strings.find_substr(buf, pat) >= 0 {
                done = true;
            }
            if done {
                break;
            }
            let chunk, err = await web_server.HttpConn<T>.http_conn_recv(self.conn, 4096, timeout_ms);
            if err != OK && err != ERR_EOF {
                break;
            }
            if len(chunk) == 0 {
                break;
            }
            buf += chunk;
        }
        return buf;
    }

    // Writes until all bytes have been accepted by the underlying transport.
    async func send_all(self: web_server.HttpConnStream<T>, data: String, timeout_ms: Int) -> Int {
        let off = 0;
        loop off < len(data) {
            let n, err = await web_server.HttpConn<T>.http_conn_send(self.conn, substr(data, off, len(data) - off), timeout_ms);
            if err != OK {
                return 1;
            }
            if n <= 0 {
                return 1;
            }
            off += n;
        }
        return 0;
    }

    // Reads a raw stream until EOF or size limit. Used by reverse proxying.
    async func recv_all(self: web_server.HttpConnStream<T>, max_total: Int, timeout_ms: Int) -> String {
        let out = "";
        loop len(out) < max_total {
            let chunk, err = await web_server.HttpConn<T>.http_conn_recv(self.conn, 8192, timeout_ms);
            if err != OK && err != ERR_EOF {
                break;
            }
            if len(chunk) == 0 {
                break;
            }
            out += chunk;
        }
        return out;
    }

    // Closes the underlying transport adapter.
    func close(self: web_server.HttpConnStream<T>) -> Void {
        _ = web_server.HttpConn<T>.http_conn_close(self.conn);
    }
}
