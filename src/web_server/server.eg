module web_server;

use web_server;
use aio.tcp;
use aio.fs;
use aio.tls;
use collections;
use os;
use runtime;
use strings;
use std;

// Transport-aware connection closer used by ClientConnection.
class ConnectionCloser {
    func init(self: web_server.ConnectionCloser) -> Void {
    }

    // Closes the fd through the matching TCP or TLS API.
    func close(self: web_server.ConnectionCloser, fd: Int, is_tls: Bool) -> Void {
        if is_tls {
            _ = aio.tls.close(fd);
        } else {
            _ = aio.tcp.close(fd);
        }
    }
}

// Accepted client connection plus request/response transport state.
class ClientConnection {
    // Accepted socket or TLS file descriptor.
    var fd: Int;
    // Whether this connection is TLS.
    var is_tls: Bool;
    // I/O timeout used by the HTTP transport.
    var timeout_ms: Int;
    // TLS SNI name captured at accept time.
    var sni: String;
    // HTTP transport wrapper for this fd.
    var transport: web_server.HttpTransport;

    func init(self: web_server.ClientConnection, fd: Int, is_tls: Bool, timeout_ms: Int) -> Void {
        self.fd = fd;
        self.is_tls = is_tls;
        self.timeout_ms = timeout_ms;
        self.transport = new web_server.HttpTransport(fd, is_tls, timeout_ms);
        self.sni = "";
        if is_tls {
            self.sni = aio.tls.server_name(fd);
        }
    }

    // Receives one complete request from the client.
    async func recv_request(self: web_server.ClientConnection, max_total: Int) -> String {
        return await self.transport.recv_request(max_total);
    }

    // Sends one complete response to the client.
    async func send(self: web_server.ClientConnection, data: String) -> Int {
        return await self.transport.send_all(data);
    }

    // Closes the connection.
    func close(self: web_server.ClientConnection) -> Void {
        _ = self.transport.close();
    }
}

// Builds listener maps and stores virtual-host snapshots for shared bind
// addresses. Multiple server blocks can share one 0.0.0.0:443 listener.
class ListenerRegistry {
    func init(self: web_server.ListenerRegistry) -> Void {
    }

    func copy_log_formats(self: web_server.ListenerRegistry, src: collections.Map<String, String>, dst: collections.Map<String, String>) -> Void {
        let util = new web_server.ServerUtil();
        let count = util.cfg_int(src, "log_format_count", 0);
        _ = dst.set("log_format_count", util.itoa(count));
        loop (let i = 0; i < count; i += 1) {
            let name_key = "log_format." + util.itoa(i) + ".name";
            let name = util.cfg_get(src, name_key, "");
            _ = dst.set(name_key, name);
            if len(name) > 0 {
                _ = dst.set("log_format." + name, util.cfg_get(src, "log_format." + name, ""));
            }
        }
    }

    // Key that groups configs by network bind address and TLS mode.
    func bind_key_for(self: web_server.ListenerRegistry, cfg: collections.Map<String, String>) -> String {
        let util = new web_server.ServerUtil();
        return util.cfg_get(cfg, "listen_host", DEFAULT_LISTEN_HOST) + "." + util.cfg_get(cfg, "listen_port", DEFAULT_LISTEN_PORT_TEXT) + "." + util.cfg_get(cfg, "https_enabled", DEFAULT_HTTPS_ENABLED);
    }

    // Checks whether a parsed server config contains a given server_name.
    func server_name_matches(self: web_server.ListenerRegistry, cfg: collections.Map<String, String>, name: String) -> Bool {
        let host = (new web_server.HttpRequestParser()).normalize_host_name(name);
        if len(host) == 0 {
            return false;
        }
        if host == DEFAULT_SERVER_NAME {
            return false;
        }
        let util = new web_server.ServerUtil();
        return strings.contains(util.cfg_get(cfg, "server_names", DEFAULT_SERVER_NAMES), "|" + host + "|");
    }

    // Checks whether a listener already has a vhost for the given name.
    func listener_has_vhost_name(self: web_server.ListenerRegistry, listener: collections.Map<String, String>, name: String) -> Bool {
        let host = (new web_server.HttpRequestParser()).normalize_host_name(name);
        if len(host) == 0 {
            return false;
        }
        if host == DEFAULT_SERVER_NAME {
            return false;
        }
        let util = new web_server.ServerUtil();
        loop (let vi = 0; vi < util.cfg_int(listener, "vhost_count", 0); vi += 1) {
            if strings.contains(util.cfg_get(listener, self.vhost_key(vi, ".server_names"), DEFAULT_SERVER_NAMES), "|" + host + "|") {
                return true;
            }
        }
        return false;
    }

    // Records a host name on HTTP listeners that should redirect to HTTPS.
    func add_https_redirect_name(self: web_server.ListenerRegistry, listener: collections.Map<String, String>, name: String) -> Void {
        let host = (new web_server.HttpRequestParser()).normalize_host_name(name);
        if len(host) == 0 {
            return;
        }
        if host == DEFAULT_SERVER_NAME {
            return;
        }
        let needle = "|" + host + "|";
        let util = new web_server.ServerUtil();
        if strings.contains(util.cfg_get(listener, "https_redirect_names", "|"), needle) {
            return;
        }
        let n = util.cfg_int(listener, "https_redirect_name_count", 0);
        _ = listener.set("https_redirect_name." + util.itoa(n), host);
        _ = listener.set("https_redirect_name_count", util.itoa(n + 1));
        _ = listener.set("https_redirect_names", util.cfg_get(listener, "https_redirect_names", "|") + host + "|");
    }

    // Key helper for vhost.N.* fields inside listener maps.
    func vhost_key(self: web_server.ListenerRegistry, idx: Int, suffix: String) -> String {
        let util = new web_server.ServerUtil();
        return "vhost." + util.itoa(idx) + suffix;
    }

    // Copies a parsed server config into the listener as one virtual host.
    func store_vhost(self: web_server.ListenerRegistry, listener: collections.Map<String, String>, src: collections.Map<String, String>) -> Void {
        let util = new web_server.ServerUtil();
        let keys = new web_server.ConfigKeys();
        let idx = util.cfg_int(listener, "vhost_count", 0);
        let base = self.vhost_key(idx, "");
        _ = listener.set(base + ".server_name", util.cfg_get(src, "server_name", DEFAULT_SERVER_NAME));
        _ = listener.set(base + ".server_name_count", util.cfg_get(src, "server_name_count", "0"));
        _ = listener.set(base + ".server_names", util.cfg_get(src, "server_names", DEFAULT_SERVER_NAMES));
        loop (let ni = 0; ni < util.cfg_int(src, "server_name_count", 0); ni += 1) {
            let name_key = "server_name." + util.itoa(ni);
            _ = listener.set(base + "." + name_key, util.cfg_get(src, name_key, DEFAULT_SERVER_NAME));
        }
        _ = listener.set(base + ".root", util.cfg_get(src, "root", "."));
        _ = listener.set(base + ".index", util.cfg_get(src, "index", DEFAULT_INDEX));
        _ = listener.set(base + ".ssl_certificate", util.cfg_get(src, "ssl_certificate", ""));
        _ = listener.set(base + ".ssl_certificate_key", util.cfg_get(src, "ssl_certificate_key", ""));
        _ = listener.set(base + ".https_redirect", util.cfg_get(src, "https_redirect", DEFAULT_HTTPS_REDIRECT));
        _ = listener.set(base + ".access_log", util.cfg_get(src, "access_log", DEFAULT_ACCESS_LOG));
        _ = listener.set(base + ".access_log_format", util.cfg_get(src, "access_log_format", DEFAULT_ACCESS_LOG_FORMAT));
        _ = listener.set(base + ".error_log", util.cfg_get(src, "error_log", DEFAULT_ERROR_LOG));
        _ = listener.set(base + ".error_log_level", util.cfg_get(src, "error_log_level", DEFAULT_ERROR_LOG_LEVEL));
        _ = listener.set(base + ".gzip", util.cfg_get(src, "gzip", DEFAULT_GZIP));
        _ = listener.set(base + ".gzip_min_length", util.cfg_get(src, "gzip_min_length", DEFAULT_GZIP_MIN_LENGTH_TEXT));
        if idx == 0 {
            _ = listener.set("server_name", util.cfg_get(src, "server_name", DEFAULT_SERVER_NAME));
            _ = listener.set("server_name_count", util.cfg_get(src, "server_name_count", "0"));
            _ = listener.set("server_names", util.cfg_get(src, "server_names", DEFAULT_SERVER_NAMES));
            loop (let ni = 0; ni < util.cfg_int(src, "server_name_count", 0); ni += 1) {
                let name_key = "server_name." + util.itoa(ni);
                _ = listener.set(name_key, util.cfg_get(src, name_key, DEFAULT_SERVER_NAME));
            }
            _ = listener.set("root", util.cfg_get(src, "root", "."));
            _ = listener.set("index", util.cfg_get(src, "index", DEFAULT_INDEX));
            _ = listener.set("https_redirect", util.cfg_get(src, "https_redirect", DEFAULT_HTTPS_REDIRECT));
            _ = listener.set("access_log", util.cfg_get(src, "access_log", DEFAULT_ACCESS_LOG));
            _ = listener.set("access_log_format", util.cfg_get(src, "access_log_format", DEFAULT_ACCESS_LOG_FORMAT));
            _ = listener.set("error_log", util.cfg_get(src, "error_log", DEFAULT_ERROR_LOG));
            _ = listener.set("error_log_level", util.cfg_get(src, "error_log_level", DEFAULT_ERROR_LOG_LEVEL));
            _ = listener.set("gzip", util.cfg_get(src, "gzip", DEFAULT_GZIP));
            _ = listener.set("gzip_min_length", util.cfg_get(src, "gzip_min_length", DEFAULT_GZIP_MIN_LENGTH_TEXT));
        }
        let loc_count = util.cfg_int(src, "loc_count", 0);
        _ = listener.set(base + ".loc_count", util.itoa(loc_count));
        if idx == 0 {
            _ = listener.set("loc_count", util.itoa(loc_count));
        }
        loop (let loc = 0; loc < loc_count; loc += 1) {
            let dst = base + ".loc." + util.itoa(loc);
            let src_key = keys.loc_key(loc, "");
            let prefix = util.cfg_get(src, src_key + ".prefix", "/");
            let mode = util.cfg_get(src, src_key + ".mode", "prefix");
            let root = util.cfg_get(src, src_key + ".root", util.cfg_get(src, "root", "."));
            let index = util.cfg_get(src, src_key + ".index", util.cfg_get(src, "index", DEFAULT_INDEX));
            let alias = util.cfg_get(src, src_key + ".alias", "");
            let proxy_pass = util.cfg_get(src, src_key + ".proxy_pass", "");
            _ = listener.set(dst + ".prefix", prefix);
            _ = listener.set(dst + ".mode", mode);
            _ = listener.set(dst + ".root", root);
            _ = listener.set(dst + ".index", index);
            _ = listener.set(dst + ".alias", alias);
            _ = listener.set(dst + ".proxy_pass", proxy_pass);
            _ = listener.set(dst + ".fastcgi_pass", "");
            let backend_kind = util.cfg_get(src, src_key + ".backend_kind", "");
            let fastcgi_backend = util.cfg_get(src, src_key + ".fastcgi_backend", "");
            let fastcgi_unix_path = util.cfg_get(src, src_key + ".fastcgi_unix_path", "");
            let fastcgi_index = util.cfg_get(src, src_key + ".fastcgi_index", DEFAULT_FASTCGI_INDEX);
            _ = listener.set(dst + ".backend_kind", backend_kind);
            _ = listener.set(dst + ".fastcgi_backend", fastcgi_backend);
            _ = listener.set(dst + ".fastcgi_unix_path", fastcgi_unix_path);
            _ = listener.set(dst + ".fastcgi_index", fastcgi_index);
            let fp_count = util.cfg_int(src, src_key + ".fastcgi_param_count", 0);
            _ = listener.set(dst + ".fastcgi_param_count", util.itoa(fp_count));
            if idx == 0 {
                let top = keys.loc_key(loc, "");
                _ = listener.set(top + ".prefix", prefix);
                _ = listener.set(top + ".mode", mode);
                _ = listener.set(top + ".root", root);
                _ = listener.set(top + ".index", index);
                _ = listener.set(top + ".alias", alias);
                _ = listener.set(top + ".proxy_pass", proxy_pass);
                _ = listener.set(top + ".fastcgi_pass", "");
                _ = listener.set(top + ".backend_kind", backend_kind);
                _ = listener.set(top + ".fastcgi_backend", fastcgi_backend);
                _ = listener.set(top + ".fastcgi_unix_path", fastcgi_unix_path);
                _ = listener.set(top + ".fastcgi_index", fastcgi_index);
                _ = listener.set(top + ".fastcgi_param_count", util.itoa(fp_count));
            }
            loop (let fpi = 0; fpi < fp_count; fpi += 1) {
                let param_key = src_key + ".fastcgi_param." + util.itoa(fpi);
                let dst_param = dst + ".fastcgi_param." + util.itoa(fpi);
                let param_name = util.cfg_get(src, param_key + ".name", "");
                let param_value = util.cfg_get(src, param_key + ".value", "");
                _ = listener.set(dst_param + ".name", param_name);
                _ = listener.set(dst_param + ".value", param_value);
                if idx == 0 {
                    let top_param = keys.loc_key(loc, ".fastcgi_param." + util.itoa(fpi));
                    _ = listener.set(top_param + ".name", param_name);
                    _ = listener.set(top_param + ".value", param_value);
                }
            }
            let try_count = util.cfg_int(src, src_key + ".try_count", 0);
            _ = listener.set(dst + ".try_count", util.itoa(try_count));
            if idx == 0 {
                _ = listener.set(keys.loc_key(loc, ".try_count"), util.itoa(try_count));
            }
            loop (let ti = 0; ti < try_count; ti += 1) {
                let try_key = ".try." + util.itoa(ti);
                let try_value = util.cfg_get(src, src_key + try_key, "");
                _ = listener.set(dst + try_key, try_value);
                if idx == 0 {
                    _ = listener.set(keys.loc_key(loc, try_key), try_value);
                }
            }
        }
        let rewrite_count = util.cfg_int(src, "rewrite_count", 0);
        _ = listener.set(base + ".rewrite_count", util.itoa(rewrite_count));
        if idx == 0 {
            _ = listener.set("rewrite_count", util.itoa(rewrite_count));
        }
        loop (let ri = 0; ri < rewrite_count; ri += 1) {
            let rewrite_dst = base + ".rewrite." + util.itoa(ri);
            let rewrite_pattern = util.cfg_get(src, keys.rewrite_key(ri, ".pattern"), "");
            let rewrite_target = util.cfg_get(src, keys.rewrite_key(ri, ".target"), "");
            _ = listener.set(rewrite_dst + ".pattern", rewrite_pattern);
            _ = listener.set(rewrite_dst + ".target", rewrite_target);
            if idx == 0 {
                _ = listener.set(keys.rewrite_key(ri, ".pattern"), rewrite_pattern);
                _ = listener.set(keys.rewrite_key(ri, ".target"), rewrite_target);
            }
        }
        _ = listener.set("vhost_count", util.itoa(idx + 1));
    }

    // Creates a listener map and seeds it with the first vhost.
    func new_listener(self: web_server.ListenerRegistry, scfg: collections.Map<String, String>, bind_key: String) -> collections.Map<String, String> {
        let util = new web_server.ServerUtil();
        let l = new collections.Map<String, String>();
        _ = l.set("bind_key", bind_key);
        _ = l.set("worker_processes", util.cfg_get(scfg, "worker_processes", DEFAULT_WORKER_PROCESSES_TEXT));
        _ = l.set("worker_connections", util.cfg_get(scfg, "worker_connections", DEFAULT_WORKER_CONNECTIONS_TEXT));
        _ = l.set("client_max_body_size", util.cfg_get(scfg, "client_max_body_size", DEFAULT_CLIENT_MAX_BODY_SIZE_TEXT));
        _ = l.set("keepalive_timeout_ms", util.cfg_get(scfg, "keepalive_timeout_ms", DEFAULT_KEEPALIVE_TIMEOUT_MS_TEXT));
        _ = l.set("proxy_timeout_ms", util.cfg_get(scfg, "proxy_timeout_ms", DEFAULT_PROXY_TIMEOUT_MS_TEXT));
        _ = l.set("max_response_bytes", util.cfg_get(scfg, "max_response_bytes", DEFAULT_MAX_RESPONSE_BYTES_TEXT));
        _ = l.set("listen_host", util.cfg_get(scfg, "listen_host", DEFAULT_LISTEN_HOST));
        _ = l.set("listen_port", util.cfg_get(scfg, "listen_port", DEFAULT_LISTEN_PORT_TEXT));
        _ = l.set("backlog", util.cfg_get(scfg, "backlog", DEFAULT_BACKLOG_TEXT));
        _ = l.set("https_enabled", util.cfg_get(scfg, "https_enabled", DEFAULT_HTTPS_ENABLED));
        _ = l.set("ssl_certificate", util.cfg_get(scfg, "ssl_certificate", ""));
        _ = l.set("ssl_certificate_key", util.cfg_get(scfg, "ssl_certificate_key", ""));
        _ = l.set("access_log", util.cfg_get(scfg, "access_log", DEFAULT_ACCESS_LOG));
        _ = l.set("access_log_format", util.cfg_get(scfg, "access_log_format", DEFAULT_ACCESS_LOG_FORMAT));
        _ = l.set("error_log", util.cfg_get(scfg, "error_log", DEFAULT_ERROR_LOG));
        _ = l.set("error_log_level", util.cfg_get(scfg, "error_log_level", DEFAULT_ERROR_LOG_LEVEL));
        self.copy_log_formats(scfg, l);
        _ = l.set("vhost_count", "0");
        _ = l.set("https_redirect_name_count", "0");
        _ = l.set("https_redirect_names", "|");
        _ = self.store_vhost(l, scfg);
        return l;
    }

    // True when the listener is configured for TLS.
    func is_https_listener(self: web_server.ListenerRegistry, listener: collections.Map<String, String>) -> Bool {
        let util = new web_server.ServerUtil();
        return util.cfg_get(listener, "https_enabled", "0") == "1";
    }

    // Returns whether a vhost should contribute HTTPS redirect hostnames.
    func vhost_allows_https_redirect(self: web_server.ListenerRegistry, listener: collections.Map<String, String>, vhost_idx: Int) -> Bool {
        let util = new web_server.ServerUtil();
        return util.cfg_get(listener, self.vhost_key(vhost_idx, ".https_redirect"), DEFAULT_HTTPS_REDIRECT) != DISABLED_TEXT;
    }

    // Adds one HTTPS vhost name to all matching HTTP listeners.
    func add_https_redirect_name_to_http_listeners(self: web_server.ListenerRegistry, plan: web_server.ListenerPlan, name: String) -> Void {
        loop (let li = 0; li < plan.listener_count; li += 1) {
            let listener = plan.load_listener(li);
            if self.is_https_listener(listener) {
                skip;
            }
            if self.listener_has_vhost_name(listener, name) {
                skip;
            }
            _ = self.add_https_redirect_name(listener, name);
            _ = plan.save_listener(li, listener);
        }
    }

    // Copies redirect names from one HTTPS vhost.
    func add_https_redirect_names_from_vhost(self: web_server.ListenerRegistry, plan: web_server.ListenerPlan, listener: collections.Map<String, String>, vhost_idx: Int) -> Void {
        if !self.vhost_allows_https_redirect(listener, vhost_idx) {
            return;
        }
        let util = new web_server.ServerUtil();
        let server_name_count = util.cfg_int(listener, self.vhost_key(vhost_idx, ".server_name_count"), 0);
        loop (let ni = 0; ni < server_name_count; ni += 1) {
            let name = util.cfg_get(listener, self.vhost_key(vhost_idx, ".server_name." + util.itoa(ni)), "");
            _ = self.add_https_redirect_name_to_http_listeners(plan, name);
        }
    }

    // After all listeners are built, marks HTTP listeners that should redirect
    // hosts also served by HTTPS.
    func add_https_redirects(self: web_server.ListenerRegistry, plan: web_server.ListenerPlan) -> Void {
        loop (let hi = 0; hi < plan.listener_count; hi += 1) {
            let listener = plan.load_listener(hi);
            if !self.is_https_listener(listener) {
                skip;
            }
            let util = new web_server.ServerUtil();
            let vhost_count = util.cfg_int(listener, "vhost_count", 0);
            loop (let vi = 0; vi < vhost_count; vi += 1) {
                _ = self.add_https_redirect_names_from_vhost(plan, listener, vi);
            }
        }
    }

    // Merges vhost lists when duplicate listener maps are compacted.
    func merge_vhosts(self: web_server.ListenerRegistry, dst: collections.Map<String, String>, src: collections.Map<String, String>) -> Void {
        let util = new web_server.ServerUtil();
        loop (let vi = 0; vi < util.cfg_int(src, "vhost_count", 0); vi += 1) {
            _ = self.store_vhost(dst, (new web_server.VirtualHostSelector(src)).copy_vhost_config(vi));
        }
    }
}

// Manual map clone helper used when listener configs must be copied before
// worker ownership changes.
class MapCloner {
    func init(self: web_server.MapCloner) -> Void {
    }

    func copy_if_present(self: web_server.MapCloner, src: collections.Map<String, String>, out: collections.Map<String, String>, key: String) -> Void {
        if src.has(key) {
            _ = out.set(key, src.get(key));
        }
    }

    func copy_log_formats(self: web_server.MapCloner, src: collections.Map<String, String>, out: collections.Map<String, String>) -> Void {
        let util = new web_server.ServerUtil();
        let count = util.cfg_int(src, "log_format_count", 0);
        _ = out.set("log_format_count", util.itoa(count));
        loop (let i = 0; i < count; i += 1) {
            let name_key = "log_format." + util.itoa(i) + ".name";
            self.copy_if_present(src, out, name_key);
            let name = util.cfg_get(src, name_key, "");
            if len(name) > 0 {
                self.copy_if_present(src, out, "log_format." + name);
            }
        }
    }

    func copy_server_names(self: web_server.MapCloner, src: collections.Map<String, String>, out: collections.Map<String, String>, base: String) -> Void {
        let util = new web_server.ServerUtil();
        let count_key = util.cfg_key_at(base, "server_name_count");
        let count = util.cfg_int(src, count_key, 0);
        _ = out.set(count_key, util.itoa(count));
        self.copy_if_present(src, out, util.cfg_key_at(base, "server_name"));
        self.copy_if_present(src, out, util.cfg_key_at(base, "server_names"));
        loop (let i = 0; i < count; i += 1) {
            self.copy_if_present(src, out, util.cfg_key_at(base, "server_name." + util.itoa(i)));
        }
    }

    func copy_locations(self: web_server.MapCloner, src: collections.Map<String, String>, out: collections.Map<String, String>, base: String) -> Void {
        let util = new web_server.ServerUtil();
        let keys = new web_server.ConfigKeys();
        let loc_count_key = util.cfg_key_at(base, "loc_count");
        let loc_count = util.cfg_int(src, loc_count_key, 0);
        _ = out.set(loc_count_key, util.itoa(loc_count));
        loop (let loc = 0; loc < loc_count; loc += 1) {
            let loc_base = keys.loc_key(loc, "");
            self.copy_if_present(src, out, util.cfg_key_at(base, loc_base + ".prefix"));
            self.copy_if_present(src, out, util.cfg_key_at(base, loc_base + ".mode"));
            self.copy_if_present(src, out, util.cfg_key_at(base, loc_base + ".root"));
            self.copy_if_present(src, out, util.cfg_key_at(base, loc_base + ".index"));
            self.copy_if_present(src, out, util.cfg_key_at(base, loc_base + ".alias"));
            self.copy_if_present(src, out, util.cfg_key_at(base, loc_base + ".proxy_pass"));
            self.copy_if_present(src, out, util.cfg_key_at(base, loc_base + ".fastcgi_pass"));
            self.copy_if_present(src, out, util.cfg_key_at(base, loc_base + ".backend_kind"));
            self.copy_if_present(src, out, util.cfg_key_at(base, loc_base + ".fastcgi_backend"));
            self.copy_if_present(src, out, util.cfg_key_at(base, loc_base + ".fastcgi_unix_path"));
            self.copy_if_present(src, out, util.cfg_key_at(base, loc_base + ".fastcgi_index"));
            let fp_count_key = util.cfg_key_at(base, loc_base + ".fastcgi_param_count");
            let fp_count = util.cfg_int(src, fp_count_key, 0);
            _ = out.set(fp_count_key, util.itoa(fp_count));
            loop (let fpi = 0; fpi < fp_count; fpi += 1) {
                let fp_key = loc_base + ".fastcgi_param." + util.itoa(fpi);
                self.copy_if_present(src, out, util.cfg_key_at(base, fp_key + ".name"));
                self.copy_if_present(src, out, util.cfg_key_at(base, fp_key + ".value"));
            }
            let try_count_key = util.cfg_key_at(base, loc_base + ".try_count");
            let try_count = util.cfg_int(src, try_count_key, 0);
            _ = out.set(try_count_key, util.itoa(try_count));
            loop (let ti = 0; ti < try_count; ti += 1) {
                self.copy_if_present(src, out, util.cfg_key_at(base, loc_base + ".try." + util.itoa(ti)));
            }
        }
    }

    func copy_rewrites(self: web_server.MapCloner, src: collections.Map<String, String>, out: collections.Map<String, String>, base: String) -> Void {
        let util = new web_server.ServerUtil();
        let keys = new web_server.ConfigKeys();
        let rewrite_count_key = util.cfg_key_at(base, "rewrite_count");
        let rewrite_count = util.cfg_int(src, rewrite_count_key, 0);
        _ = out.set(rewrite_count_key, util.itoa(rewrite_count));
        loop (let ri = 0; ri < rewrite_count; ri += 1) {
            self.copy_if_present(src, out, util.cfg_key_at(base, keys.rewrite_key(ri, ".pattern")));
            self.copy_if_present(src, out, util.cfg_key_at(base, keys.rewrite_key(ri, ".target")));
        }
    }

    func copy_server_base(self: web_server.MapCloner, src: collections.Map<String, String>, out: collections.Map<String, String>, base: String) -> Void {
        let util = new web_server.ServerUtil();
        self.copy_server_names(src, out, base);
        self.copy_if_present(src, out, util.cfg_key_at(base, "root"));
        self.copy_if_present(src, out, util.cfg_key_at(base, "index"));
        self.copy_if_present(src, out, util.cfg_key_at(base, "ssl_certificate"));
        self.copy_if_present(src, out, util.cfg_key_at(base, "ssl_certificate_key"));
        self.copy_if_present(src, out, util.cfg_key_at(base, "https_redirect"));
        self.copy_if_present(src, out, util.cfg_key_at(base, "access_log"));
        self.copy_if_present(src, out, util.cfg_key_at(base, "access_log_format"));
        self.copy_if_present(src, out, util.cfg_key_at(base, "error_log"));
        self.copy_if_present(src, out, util.cfg_key_at(base, "error_log_level"));
        self.copy_if_present(src, out, util.cfg_key_at(base, "gzip"));
        self.copy_if_present(src, out, util.cfg_key_at(base, "gzip_min_length"));
        self.copy_locations(src, out, base);
        self.copy_rewrites(src, out, base);
    }

    func clone(self: web_server.MapCloner, src: collections.Map<String, String>) -> collections.Map<String, String> {
        let out = new collections.Map<String, String>();
        let util = new web_server.ServerUtil();
        self.copy_if_present(src, out, "bind_key");
        self.copy_if_present(src, out, "worker_processes");
        self.copy_if_present(src, out, "worker_connections");
        self.copy_if_present(src, out, "client_max_body_size");
        self.copy_if_present(src, out, "keepalive_timeout_ms");
        self.copy_if_present(src, out, "proxy_timeout_ms");
        self.copy_if_present(src, out, "max_response_bytes");
        self.copy_if_present(src, out, "listen_host");
        self.copy_if_present(src, out, "listen_port");
        self.copy_if_present(src, out, "backlog");
        self.copy_if_present(src, out, "https_enabled");
        self.copy_if_present(src, out, "ssl_certificate");
        self.copy_if_present(src, out, "ssl_certificate_key");
        self.copy_log_formats(src, out);
        let redirect_count = util.cfg_int(src, "https_redirect_name_count", 0);
        _ = out.set("https_redirect_name_count", util.itoa(redirect_count));
        self.copy_if_present(src, out, "https_redirect_names");
        loop (let i = 0; i < redirect_count; i += 1) {
            self.copy_if_present(src, out, "https_redirect_name." + util.itoa(i));
        }
        self.copy_server_base(src, out, "");
        let vhost_count = util.cfg_int(src, "vhost_count", 0);
        _ = out.set("vhost_count", util.itoa(vhost_count));
        loop (let vi = 0; vi < vhost_count; vi += 1) {
            self.copy_server_base(src, out, "vhost." + util.itoa(vi));
        }
        return out;
    }
}

// Complete runtime listener plan derived from parsed config.
class ListenerPlan {
    // Flat listener storage. Each logical listener is stored under
    // listener.<idx>.<key> so the plan does not keep Map objects inside
    // Vector<Any> across forked workers.
    var listener_store: collections.Map<String, String>;
    // bind_key -> listener index.
    var listener_index: collections.Map<String, Int>;
    // Number of active listeners.
    var listener_count: Int;
    // Number of vhosts merged into already existing listeners.
    var shared_vhosts: Int;
    // Helper for listener/vhost copy operations.
    var registry: web_server.ListenerRegistry;

    func init(self: web_server.ListenerPlan) -> Void {
        self.listener_store = new collections.Map<String, String>();
        self.listener_index = new collections.Map<String, Int>();
        self.listener_count = 0;
        self.shared_vhosts = 0;
        self.registry = new web_server.ListenerRegistry();
    }

    // Looks up a listener by bind key.
    func find_listener(self: web_server.ListenerPlan, key: String) -> Int {
        if self.listener_index.has(key) {
            return self.listener_index.get(key);
        }
        return -1;
    }

    // Key helper for listener.N.* values.
    func key(self: web_server.ListenerPlan, idx: Int, suffix: String) -> String {
        let util = new web_server.ServerUtil();
        return "listener." + util.itoa(idx) + suffix;
    }

    // Copies a value between prefixed maps when rebuilding listener entries.
    func copy_prefixed(self: web_server.ListenerPlan, dst: collections.Map<String, String>, dst_prefix: String, src: collections.Map<String, String>, src_prefix: String, suffix: String, def: String) -> Void {
        let dst_key = dst_prefix + suffix;
        let src_key = src_prefix + suffix;
        if len(dst_prefix) == 0 && len(suffix) > 0 && substr(suffix, 0, 1) == "." {
            dst_key = substr(suffix, 1, len(suffix) - 1);
        }
        if len(src_prefix) == 0 && len(suffix) > 0 && substr(suffix, 0, 1) == "." {
            src_key = substr(suffix, 1, len(suffix) - 1);
        }
        let util = new web_server.ServerUtil();
        _ = dst.set(dst_key, util.cfg_get(src, src_key, def));
    }

    // Copies one listener map into a flat store using listener.<idx>.<key>.
    func store_listener_in(self: web_server.ListenerPlan, store: collections.Map<String, String>, idx: Int, l: collections.Map<String, String>) -> Void {
        let util = new web_server.ServerUtil();
        let prefix = self.key(idx, ".");
        let keys = l.keys();
        loop (let i = 0; i < keys.len(); i += 1) {
            let k = keys.get_unchecked(i);
            _ = store.set(prefix + k, util.cfg_get(l, k, ""));
        }
    }

    // Rebuilds a listener map from a flat store.
    func load_listener_from(self: web_server.ListenerPlan, store: collections.Map<String, String>, idx: Int) -> collections.Map<String, String> {
        let out = new collections.Map<String, String>();
        let prefix = self.key(idx, ".");
        let plen = len(prefix);
        let keys = store.keys();
        loop (let i = 0; i < keys.len(); i += 1) {
            let k = keys.get_unchecked(i);
            if len(k) >= plen && substr(k, 0, plen) == prefix {
                _ = out.set(substr(k, plen, len(k) - plen), store.get(k));
            }
        }
        return out;
    }

    // Stores the modified listener map back into the vector entry.
    func save_listener(self: web_server.ListenerPlan, idx: Int, l: collections.Map<String, String>) -> Void {
        _ = self.store_listener_in(self.listener_store, idx, l);
        let util = new web_server.ServerUtil();
        _ = self.listener_index.set(util.cfg_get(l, "bind_key", ""), idx);
    }

    // Loads a listener map by index.
    func load_listener(self: web_server.ListenerPlan, idx: Int) -> collections.Map<String, String> {
        return self.load_listener_from(self.listener_store, idx);
    }

    // Removes duplicate bind entries and merges their vhost lists.
    func compact_duplicates(self: web_server.ListenerPlan) -> Void {
        if self.listener_count <= 1 {
            return;
        }
        let compact_store = new collections.Map<String, String>();
        let compact_index = new collections.Map<String, Int>();
        let compact_count = 0;
        let util = new web_server.ServerUtil();
        loop (let i = 0; i < self.listener_count; i += 1) {
            let listener = self.load_listener(i);
            let bind_key = util.cfg_get(listener, "bind_key", "");
            if compact_index.has(bind_key) {
                let existing = compact_index.get(bind_key);
                let existing_listener = self.load_listener_from(compact_store, existing);
                _ = self.registry.merge_vhosts(existing_listener, listener);
                _ = self.store_listener_in(compact_store, existing, existing_listener);
                self.shared_vhosts += 1;
            } else {
                _ = self.store_listener_in(compact_store, compact_count, listener);
                _ = compact_index.set(bind_key, compact_count);
                compact_count += 1;
            }
        }
        self.listener_store = compact_store;
        self.listener_index = compact_index;
        self.listener_count = compact_count;
    }

    // Adds one server/listener config to the plan.
    func add(self: web_server.ListenerPlan, scfg: collections.Map<String, String>) -> Void {
        let bind_key = self.registry.bind_key_for(scfg);
        let existing = self.find_listener(bind_key);
        if existing >= 0 {
            let l = self.load_listener(existing);
            _ = self.registry.store_vhost(l, scfg);
            _ = self.save_listener(existing, l);
            self.shared_vhosts += 1;
        } else {
            _ = self.save_listener(self.listener_count, self.registry.new_listener(scfg, bind_key));
            self.listener_count += 1;
        }
    }

    // Checks whether a server config has any HTTPS listener.
    func has_https_listener_config(self: web_server.ListenerPlan, cfg: collections.Map<String, String>) -> Bool {
        let util = new web_server.ServerUtil();
        let keys = new web_server.ConfigKeys();
        loop (let server_idx = 0; server_idx < util.cfg_int(cfg, "server_count", 0); server_idx += 1) {
            loop (let listen_idx = 0; listen_idx < util.cfg_int(cfg, keys.server_key(server_idx, ".listen_count"), 0); listen_idx += 1) {
                if util.cfg_get(cfg, keys.server_listen_key(server_idx, listen_idx, ".https"), "0") == "1" {
                    return true;
                }
            }
        }
        return false;
    }

    // Builds the full plan from all parsed server blocks.
    func build(self: web_server.ListenerPlan, cfg: collections.Map<String, String>) -> Void {
        let util = new web_server.ServerUtil();
        let keys = new web_server.ConfigKeys();
        let dsl = new web_server.ConfigDsl();
        loop (let server_idx = 0; server_idx < util.cfg_int(cfg, "server_count", 0); server_idx += 1) {
            loop (let listen_idx = 0; listen_idx < util.cfg_int(cfg, keys.server_key(server_idx, ".listen_count"), 0); listen_idx += 1) {
                _ = self.add(dsl.copy_server_config(cfg, server_idx, listen_idx));
            }
        }
        _ = self.compact_duplicates();
        if self.has_https_listener_config(cfg) {
            _ = self.registry.add_https_redirects(self);
        }
    }
}

// Request-time router for HTTPS redirects and vhost base selection.
class VirtualHostRouter {
    // Listener map containing default config and vhost.N.* snapshots.
    var listener: collections.Map<String, String>;

    func init(self: web_server.VirtualHostRouter, listener: collections.Map<String, String>) -> Void {
        self.listener = listener;
    }

    func deinit(self: web_server.VirtualHostRouter) -> Void {
    }

    // Determines whether this HTTP request should be redirected to HTTPS.
    func should_redirect_https(self: web_server.VirtualHostRouter, req: web_server.HttpRequest) -> Bool {
        let host = req.host();
        if len(host) == 0 {
            return false;
        }
        let util = new web_server.ServerUtil();
        return strings.contains(util.cfg_get(self.listener, "https_redirect_names", "|"), "|" + host + "|");
    }

    // Builds the HTTPS redirect URL.
    func redirect_url(self: web_server.VirtualHostRouter, req: web_server.HttpRequest) -> String {
        return "https://" + req.host() + req.path();
    }

    // Selects the config base for the request Host or TLS SNI.
    func select_base(self: web_server.VirtualHostRouter, req: web_server.HttpRequest, sni: String) -> String {
        return (new web_server.VirtualHostSelector(self.listener)).select_vhost_base(req, sni);
    }
}

// Immutable request handling context passed into concrete handlers.
class RequestContext {
    // Matched location index.
    var loc: Int;
    // Parsed HTTP request.
    var req: web_server.HttpRequest;
    // Rewritten request path.
    var path: String;
    // Final keep-alive decision.
    var keep_alive: Bool;
    // Client connection, needed by FastCGI peer variables.
    var conn: web_server.ClientConnection;

    func init(self: web_server.RequestContext, loc: Int, req: web_server.HttpRequest, path: String, keep_alive: Bool, conn: web_server.ClientConnection) -> Void {
        self.loc = loc;
        self.req = req;
        self.path = path;
        self.keep_alive = keep_alive;
        self.conn = conn;
    }

    func deinit(self: web_server.RequestContext) -> Void {
    }
}

// Handler interface for redirect, static, proxy, and FastCGI backends.
norm RequestHandler<T> {
    async func handle_request(self: T, cfg: collections.Map<String, String>, cfg_base: String, ctx: web_server.RequestContext) -> String;
}

// Handler that returns an HTTP redirect response.
class RedirectRequestHandler {
    // Target URL for the Location header.
    var location: String;

    func init(self: web_server.RedirectRequestHandler, location: String) -> Void {
        self.location = location;
    }

    func deinit(self: web_server.RedirectRequestHandler) -> Void {
    }
}

norm impl RequestHandler<web_server.RedirectRequestHandler> {
    async func handle_request(self: web_server.RedirectRequestHandler, cfg: collections.Map<String, String>, cfg_base: String, ctx: web_server.RequestContext) -> String {
        let factory = new web_server.HttpResponseFactory();
        return factory.redirect_response(self.location, false);
    }
}

// Handler that serves files from disk.
class StaticRequestHandler {
    func init(self: web_server.StaticRequestHandler) -> Void {
    }

    func deinit(self: web_server.StaticRequestHandler) -> Void {
    }
}

norm impl RequestHandler<web_server.StaticRequestHandler> {
    async func handle_request(self: web_server.StaticRequestHandler, cfg: collections.Map<String, String>, cfg_base: String, ctx: web_server.RequestContext) -> String {
        return await (new web_server.StaticFileServer()).serve(cfg, cfg_base, ctx.req, ctx.loc, ctx.path, ctx.keep_alive);
    }
}

// Handler that forwards the request to proxy_pass.
class ProxyRequestHandler {
    // Reverse proxy implementation.
    var proxy: web_server.ReverseProxy;
    // Configured proxy_pass target.
    var proxy_pass: String;

    func init(self: web_server.ProxyRequestHandler, proxy_pass: String) -> Void {
        self.proxy = new web_server.ReverseProxy();
        self.proxy_pass = proxy_pass;
    }

    func deinit(self: web_server.ProxyRequestHandler) -> Void {
    }
}

norm impl RequestHandler<web_server.ProxyRequestHandler> {
    async func handle_request(self: web_server.ProxyRequestHandler, cfg: collections.Map<String, String>, cfg_base: String, ctx: web_server.RequestContext) -> String {
        return await self.proxy.request(cfg, ctx.req, self.proxy_pass, ctx.path + ctx.req.query(), ctx.keep_alive);
    }
}

// Handler that forwards the request to FastCGI/PHP-FPM.
class FastcgiRequestHandler {
    // Configured fastcgi_pass target.
    var fastcgi_pass: String;

    func init(self: web_server.FastcgiRequestHandler, fastcgi_pass: String) -> Void {
        self.fastcgi_pass = fastcgi_pass;
    }

    func deinit(self: web_server.FastcgiRequestHandler) -> Void {
    }
}

norm impl RequestHandler<web_server.FastcgiRequestHandler> {
    async func handle_request(self: web_server.FastcgiRequestHandler, cfg: collections.Map<String, String>, cfg_base: String, ctx: web_server.RequestContext) -> String {
        return await (new web_server.FastcgiGateway()).request(cfg, cfg_base, ctx.loc, ctx.req, ctx.path, ctx.keep_alive, ctx.conn.fd, ctx.conn.is_tls, self.fastcgi_pass);
    }
}

// Central request dispatcher. It applies redirects, selects the vhost, applies
// rewrites, matches the location, and delegates to the chosen backend.
class RequestDispatcher {
    // Per-request keep-alive decision used by generated responses.
    var keep_alive: Bool;

    func init(self: web_server.RequestDispatcher) -> Void {
        self.keep_alive = false;
    }

    func deinit(self: web_server.RequestDispatcher) -> Void {
    }

    // Dispatches one parsed request against the listener map.
    async func dispatch(self: web_server.RequestDispatcher, listener: collections.Map<String, String>, conn: web_server.ClientConnection, req: web_server.HttpRequest, allow_keep_alive: Bool = true) -> String {
        let util = new web_server.ServerUtil();
        let keys = new web_server.ConfigKeys();
        let router = new web_server.VirtualHostRouter(listener);
        self.keep_alive = false;
        if !conn.is_tls && router.should_redirect_https(req) {
            let ctx = new web_server.RequestContext(0, req, req.path(), false, conn);
            return await web_server.RequestHandler<web_server.RedirectRequestHandler>.handle_request(new web_server.RedirectRequestHandler(router.redirect_url(req)), listener, "", ctx);
        }
        let cfg_base = router.select_base(req, conn.sni);
        self.keep_alive = req.keep_alive();
        if !allow_keep_alive {
            self.keep_alive = false;
        }
        if conn.timeout_ms <= 0 {
            self.keep_alive = false;
        }
        let dsl = new web_server.ConfigDsl();
        let path = dsl.apply_rewrites_at(listener, cfg_base, req.path());
        let loc = util.match_loc_at(listener, cfg_base, path);
        let proxy_pass = util.cfg_get_at(listener, cfg_base, keys.loc_key(loc, ".proxy_pass"), "");
        let backend_kind = util.cfg_get_at(listener, cfg_base, keys.loc_key(loc, ".backend_kind"), "");
        let fastcgi_pass = util.cfg_get_at(listener, cfg_base, keys.loc_key(loc, ".fastcgi_backend"), "");
        let ctx = new web_server.RequestContext(loc, req, path, self.keep_alive, conn);
        let resp = "";
        if len(proxy_pass) > 0 {
            self.keep_alive = false;
            ctx.keep_alive = false;
            let proxy_timeout_ms = util.cfg_int(listener, "proxy_timeout_ms", DEFAULT_PROXY_TIMEOUT_MS);
            let max_response_bytes = util.cfg_int(listener, "max_response_bytes", DEFAULT_MAX_RESPONSE_BYTES);
            resp = await (new web_server.ReverseProxy()).request_with_limits(req, proxy_pass, path, false, proxy_timeout_ms, max_response_bytes);
        } else if backend_kind == "fastcgi" && len(fastcgi_pass) > 0 {
            self.keep_alive = false;
            ctx.keep_alive = false;
            resp = await web_server.RequestHandler<web_server.FastcgiRequestHandler>.handle_request(new web_server.FastcgiRequestHandler(fastcgi_pass), listener, cfg_base, ctx);
        } else {
            resp = await web_server.RequestHandler<web_server.StaticRequestHandler>.handle_request(new web_server.StaticRequestHandler(), listener, cfg_base, ctx);
        }
        return resp;
    }
}

// Lower-level virtual-host selector retained for code paths that need to copy
// one vhost into a standalone config map.
class VirtualHostSelector {
    // Listener map containing virtual-host snapshots.
    var listener: collections.Map<String, String>;
    // Shared key helper for vhost fields.
    var registry: web_server.ListenerRegistry;

    func init(self: web_server.VirtualHostSelector, listener: collections.Map<String, String>) -> Void {
        self.listener = listener;
        self.registry = new web_server.ListenerRegistry();
    }

    func deinit(self: web_server.VirtualHostSelector) -> Void {
    }

    // Checks a host name against one vhost server_name list.
    func vhost_matches(self: web_server.VirtualHostSelector, idx: Int, name: String) -> Bool {
        let host = (new web_server.HttpRequestParser()).normalize_host_name(name);
        if len(host) == 0 {
            return false;
        }
        if host == DEFAULT_SERVER_NAME {
            return false;
        }
        let util = new web_server.ServerUtil();
        let registry = new web_server.ListenerRegistry();
        return strings.contains(util.cfg_get(self.listener, registry.vhost_key(idx, ".server_names"), DEFAULT_SERVER_NAMES), "|" + host + "|");
    }

    // Copies one vhost snapshot into a normal server config map.
    func copy_vhost_config(self: web_server.VirtualHostSelector, idx: Int) -> collections.Map<String, String> {
        let util = new web_server.ServerUtil();
        let keys = new web_server.ConfigKeys();
        let registry = new web_server.ListenerRegistry();
        let out = new collections.Map<String, String>();
        let base = registry.vhost_key(idx, "");
        _ = out.set("worker_processes", util.cfg_get(self.listener, "worker_processes", DEFAULT_WORKER_PROCESSES_TEXT));
        _ = out.set("worker_connections", util.cfg_get(self.listener, "worker_connections", DEFAULT_WORKER_CONNECTIONS_TEXT));
        _ = out.set("client_max_body_size", util.cfg_get(self.listener, "client_max_body_size", DEFAULT_CLIENT_MAX_BODY_SIZE_TEXT));
        _ = out.set("keepalive_timeout_ms", util.cfg_get(self.listener, "keepalive_timeout_ms", DEFAULT_KEEPALIVE_TIMEOUT_MS_TEXT));
        _ = out.set("proxy_timeout_ms", util.cfg_get(self.listener, "proxy_timeout_ms", DEFAULT_PROXY_TIMEOUT_MS_TEXT));
        _ = out.set("max_response_bytes", util.cfg_get(self.listener, "max_response_bytes", DEFAULT_MAX_RESPONSE_BYTES_TEXT));
        _ = out.set("server_name", util.cfg_get(self.listener, base + ".server_name", DEFAULT_SERVER_NAME));
        _ = out.set("server_name_count", util.cfg_get(self.listener, base + ".server_name_count", "0"));
        _ = out.set("server_names", util.cfg_get(self.listener, base + ".server_names", DEFAULT_SERVER_NAMES));
        _ = out.set("root", util.cfg_get(self.listener, base + ".root", "."));
        _ = out.set("index", util.cfg_get(self.listener, base + ".index", DEFAULT_INDEX));
        _ = out.set("ssl_certificate", util.cfg_get(self.listener, base + ".ssl_certificate", ""));
        _ = out.set("ssl_certificate_key", util.cfg_get(self.listener, base + ".ssl_certificate_key", ""));
        _ = out.set("https_redirect", util.cfg_get(self.listener, base + ".https_redirect", DEFAULT_HTTPS_REDIRECT));
        _ = out.set("access_log", util.cfg_get(self.listener, base + ".access_log", util.cfg_get(self.listener, "access_log", DEFAULT_ACCESS_LOG)));
        _ = out.set("access_log_format", util.cfg_get(self.listener, base + ".access_log_format", util.cfg_get(self.listener, "access_log_format", DEFAULT_ACCESS_LOG_FORMAT)));
        _ = out.set("error_log", util.cfg_get(self.listener, base + ".error_log", util.cfg_get(self.listener, "error_log", DEFAULT_ERROR_LOG)));
        _ = out.set("error_log_level", util.cfg_get(self.listener, base + ".error_log_level", util.cfg_get(self.listener, "error_log_level", DEFAULT_ERROR_LOG_LEVEL)));
        (new web_server.ListenerRegistry()).copy_log_formats(self.listener, out);
        _ = out.set("listen_host", util.cfg_get(self.listener, "listen_host", DEFAULT_LISTEN_HOST));
        _ = out.set("listen_port", util.cfg_get(self.listener, "listen_port", DEFAULT_LISTEN_PORT_TEXT));
        _ = out.set("backlog", util.cfg_get(self.listener, "backlog", DEFAULT_BACKLOG_TEXT));
        _ = out.set("https_enabled", util.cfg_get(self.listener, "https_enabled", DEFAULT_HTTPS_ENABLED));
        _ = out.set("gzip", util.cfg_get(self.listener, base + ".gzip", util.cfg_get(self.listener, "gzip", DEFAULT_GZIP)));
        _ = out.set("gzip_min_length", util.cfg_get(self.listener, base + ".gzip_min_length", util.cfg_get(self.listener, "gzip_min_length", DEFAULT_GZIP_MIN_LENGTH_TEXT)));
        let loc_count = util.cfg_int(self.listener, base + ".loc_count", 0);
        _ = out.set("loc_count", util.itoa(loc_count));
        loop (let loc = 0; loc < loc_count; loc += 1) {
            let src = base + ".loc." + util.itoa(loc);
            let dst = keys.loc_key(loc, "");
            _ = out.set(dst + ".prefix", util.cfg_get(self.listener, src + ".prefix", "/"));
            _ = out.set(dst + ".mode", util.cfg_get(self.listener, src + ".mode", "prefix"));
            _ = out.set(dst + ".root", util.cfg_get(self.listener, src + ".root", out.get("root")));
            _ = out.set(dst + ".index", util.cfg_get(self.listener, src + ".index", out.get("index")));
            _ = out.set(dst + ".alias", util.cfg_get(self.listener, src + ".alias", ""));
            _ = out.set(dst + ".proxy_pass", util.cfg_get(self.listener, src + ".proxy_pass", ""));
            _ = out.set(dst + ".fastcgi_pass", "");
            _ = out.set(dst + ".backend_kind", util.cfg_get(self.listener, src + ".backend_kind", ""));
            _ = out.set(dst + ".fastcgi_backend", util.cfg_get(self.listener, src + ".fastcgi_backend", ""));
            _ = out.set(dst + ".fastcgi_unix_path", util.cfg_get(self.listener, src + ".fastcgi_unix_path", ""));
            _ = out.set(dst + ".fastcgi_index", util.cfg_get(self.listener, src + ".fastcgi_index", DEFAULT_FASTCGI_INDEX));
            let fp_count = util.cfg_int(self.listener, src + ".fastcgi_param_count", 0);
            _ = out.set(dst + ".fastcgi_param_count", util.itoa(fp_count));
            loop (let fpi = 0; fpi < fp_count; fpi += 1) {
                let param_key = src + ".fastcgi_param." + util.itoa(fpi);
                let dst_param = dst + ".fastcgi_param." + util.itoa(fpi);
                _ = out.set(dst_param + ".name", util.cfg_get(self.listener, param_key + ".name", ""));
                _ = out.set(dst_param + ".value", util.cfg_get(self.listener, param_key + ".value", ""));
            }
            let try_count = util.cfg_int(self.listener, src + ".try_count", 0);
            _ = out.set(dst + ".try_count", util.itoa(try_count));
            loop (let ti = 0; ti < try_count; ti += 1) {
                let try_key = ".try." + util.itoa(ti);
                _ = out.set(dst + try_key, util.cfg_get(self.listener, src + try_key, ""));
            }
        }
        let rewrite_count = util.cfg_int(self.listener, base + ".rewrite_count", 0);
        _ = out.set("rewrite_count", util.itoa(rewrite_count));
        loop (let ri = 0; ri < rewrite_count; ri += 1) {
            let rewrite_src = base + ".rewrite." + util.itoa(ri);
            _ = out.set(keys.rewrite_key(ri, ".pattern"), util.cfg_get(self.listener, rewrite_src + ".pattern", ""));
            _ = out.set(keys.rewrite_key(ri, ".target"), util.cfg_get(self.listener, rewrite_src + ".target", ""));
        }
        return out;
    }

    // Returns the config-base prefix for an in-listener vhost.
    func vhost_base(self: web_server.VirtualHostSelector, idx: Int) -> String {
        return self.registry.vhost_key(idx, "");
    }

    // Selects vhost by Host first, then by TLS SNI, then defaults to listener.
    func select_vhost_base(self: web_server.VirtualHostSelector, req: web_server.HttpRequest, sni: String) -> String {
        let util = new web_server.ServerUtil();
        let host = req.host();
        let i = 0;
        if len(host) > 0 {
            loop (i = 0; i < util.cfg_int(self.listener, "vhost_count", 0); i += 1) {
                if self.vhost_matches(i, host) {
                    return self.vhost_base(i);
                }
            }
        }
        let j = 0;
        if len(sni) > 0 {
            loop (j = 0; j < util.cfg_int(self.listener, "vhost_count", 0); j += 1) {
                if self.vhost_matches(j, sni) {
                    return self.vhost_base(j);
                }
            }
        }
        if util.cfg_int(self.listener, "vhost_count", 0) > 0 {
            return self.vhost_base(0);
        }
        return "";
    }
}

// Per-client task used by worker_loop. It owns the accepted fd until the
// keep-alive loop finishes or an error closes the connection.
class ClientRequestTask {
    func init(self: web_server.ClientRequestTask) -> Void {
    }

    // Handles a client connection, including repeated requests on keep-alive.
    // Every valid request goes through RequestDispatcher.
    async func handle(self: web_server.ClientRequestTask, listener: collections.Map<String, String>, is_tls: Bool, cfd: Int, logger: web_server.WebLogger) -> Int {
        let util = new web_server.ServerUtil();
        let max_body = util.cfg_int(listener, "client_max_body_size", DEFAULT_CLIENT_MAX_BODY_SIZE);
        let timeout_ms = util.cfg_int(listener, "keepalive_timeout_ms", DEFAULT_KEEPALIVE_TIMEOUT_MS);
        let conn = new web_server.ClientConnection(cfd, is_tls, timeout_ms);
        let factory = new web_server.HttpResponseFactory();
        let keepalive_limit = DEFAULT_KEEPALIVE_REQUEST_LIMIT;
        let handled = 0;
        let open = true;
        loop open {
            let req = await conn.recv_request(max_body);
            if len(req) == 0 {
                open = false;
            } else if strings.find_substr(req, "\r\n\r\n") < 0 {
                let bad_response = factory.response_conn(400, "text/plain", "Bad Request", false);
                _ = await conn.send(bad_response);
                logger.write_error(listener, "info", "client sent an invalid HTTP request");
                open = false;
            } else if len(req) >= max_body {
                let large_response = factory.response_conn(413, "text/plain", "Payload Too Large", false);
                _ = await conn.send(large_response);
                logger.write_error(listener, "warn", "client request body is larger than client_max_body_size");
                open = false;
            } else {
                let request = new web_server.HttpRequest(req);
                let dispatcher = new web_server.RequestDispatcher();
                let response = await dispatcher.dispatch(listener, conn, request, handled + 1 < keepalive_limit);
                _ = await conn.send(response);
                logger.write_access(listener, conn, request, response);
                handled += 1;
                if !dispatcher.keep_alive {
                    open = false;
                }
            }
        }
        _ = conn.close();
        return handled;
    }
}

// One listening socket and its associated listener config.
class ServerListener {
    // Listener config map.
    var listener: collections.Map<String, String>;
    // Whether the socket accepts TLS clients.
    var is_tls: Bool;
    // Listening fd after open().
    var listen_fd: Int;

    func init(self: web_server.ServerListener, listener: collections.Map<String, String>) -> Void {
        let util = new web_server.ServerUtil();
        self.listener = listener;
        self.is_tls = util.cfg_get(self.listener, "__is_tls", util.cfg_get(self.listener, "https_enabled", "0")) == "1";
        self.listen_fd = util.cfg_int(self.listener, "__listen_fd", 0);
    }

    func deinit(self: web_server.ServerListener) -> Void {
    }

    // Creates the OS listening socket, using TLS listen when required.
    func listen_conn(self: web_server.ServerListener) -> Int, ErrCode {
        let util = new web_server.ServerUtil();
        if self.is_tls {
            let lfd, lfd_err = aio.tls.listen(
            util.cfg_get(self.listener, "listen_host", DEFAULT_LISTEN_HOST),
            util.cfg_int(self.listener, "listen_port", DEFAULT_LISTEN_PORT),
            util.cfg_int(self.listener, "backlog", DEFAULT_BACKLOG),
            util.cfg_get(self.listener, "ssl_certificate", ""),
            util.cfg_get(self.listener, "ssl_certificate_key", "")
            );
            return lfd, lfd_err;
        }
        let tcp_listen_fd, tcp_listen_err = aio.tcp.listen(util.cfg_get(self.listener, "listen_host", DEFAULT_LISTEN_HOST), util.cfg_int(self.listener, "listen_port", DEFAULT_LISTEN_PORT), util.cfg_int(self.listener, "backlog", DEFAULT_BACKLOG));
        return tcp_listen_fd, tcp_listen_err;
    }

    // Registers SNI certificates for virtual hosts on a TLS listener.
    func register_tls_server_certs(self: web_server.ServerListener) -> ErrCode {
        let util = new web_server.ServerUtil();
        let registry = new web_server.ListenerRegistry();
        loop (let vi = 0; vi < util.cfg_int(self.listener, "vhost_count", 0); vi += 1) {
            let cert = util.cfg_get(self.listener, registry.vhost_key(vi, ".ssl_certificate"), "");
            let key = util.cfg_get(self.listener, registry.vhost_key(vi, ".ssl_certificate_key"), "");
            if len(cert) > 0 && len(key) > 0 {
                loop (let ni = 0; ni < util.cfg_int(self.listener, registry.vhost_key(vi, ".server_name_count"), 0); ni += 1) {
                    let name = util.cfg_get(self.listener, registry.vhost_key(vi, ".server_name." + util.itoa(ni)), "");
                    if len(name) > 0 && name != DEFAULT_SERVER_NAME {
                        let _, err = aio.tls.add_server_cert(self.listen_fd, name, cert, key);
                        if err != OK {
                            return err;
                        }
                    }
                }
            }
        }
        return OK;
    }

    // Opens the listener and stores the resulting fd in the listener map.
    func open(self: web_server.ServerListener) -> ErrCode {
        let util = new web_server.ServerUtil();
        self.is_tls = util.cfg_get(self.listener, "https_enabled", "0") == "1";
        let lfd, lfd_err = self.listen_conn();
        if lfd_err != OK {
            return lfd_err;
        }
        if lfd <= 0 {
            return ERR_IO;
        }
        self.listen_fd = lfd;
        if self.is_tls {
            let cert_err = self.register_tls_server_certs();
            if cert_err != OK {
                (new web_server.ConnectionCloser()).close(lfd, self.is_tls);
                return cert_err;
            }
        }
        _ = self.listener.set("__listen_fd", util.itoa(lfd));
        if self.is_tls {
            _ = self.listener.set("__is_tls", "1");
        } else {
            _ = self.listener.set("__is_tls", "0");
        }
        return OK;
    }

    // Closes the listening fd.
    func close(self: web_server.ServerListener) -> Void {
        let util = new web_server.ServerUtil();
        if self.listen_fd <= 0 {
            self.listen_fd = util.cfg_int(self.listener, "__listen_fd", 0);
        }
        if self.listen_fd > 0 {
            (new web_server.ConnectionCloser()).close(self.listen_fd, self.is_tls);
            self.listen_fd = 0;
            _ = self.listener.set("__listen_fd", "0");
        }
    }

    // Accepts one client connection.
    async func accept(self: web_server.ServerListener, timeout_ms: Int) -> Int, ErrCode {
        if self.is_tls {
            let cfd, err = await aio.tls.accept(self.listen_fd, timeout_ms);
            return cfd, err;
        }
        let tcp_client_fd, tcp_accept_err = await aio.tcp.accept(self.listen_fd, timeout_ms);
        return tcp_client_fd, tcp_accept_err;
    }

    // Handles one accepted client through RequestDispatcher.
    async func handle(self: web_server.ServerListener, cfd: Int, logger: web_server.WebLogger) -> Int {
        let util = new web_server.ServerUtil();
        let max_body = util.cfg_int(self.listener, "client_max_body_size", DEFAULT_CLIENT_MAX_BODY_SIZE);
        let timeout_ms = util.cfg_int(self.listener, "keepalive_timeout_ms", DEFAULT_KEEPALIVE_TIMEOUT_MS);
        let conn = new web_server.ClientConnection(cfd, self.is_tls, timeout_ms);
        let factory = new web_server.HttpResponseFactory();
        let keepalive_limit = DEFAULT_KEEPALIVE_REQUEST_LIMIT;
        let handled = 0;
        let open = true;
        loop open {
            let req = await conn.recv_request(max_body);
            if len(req) == 0 {
                open = false;
            } else if strings.find_substr(req, "\r\n\r\n") < 0 {
                let bad_response = factory.response_conn(400, "text/plain", "Bad Request", false);
                _ = await conn.send(bad_response);
                logger.write_error(self.listener, "info", "client sent an invalid HTTP request");
                open = false;
            } else if len(req) >= max_body {
                let large_response = factory.response_conn(413, "text/plain", "Payload Too Large", false);
                _ = await conn.send(large_response);
                logger.write_error(self.listener, "warn", "client request body is larger than client_max_body_size");
                open = false;
            } else {
                let request = new web_server.HttpRequest(req);
                let dispatcher = new web_server.RequestDispatcher();
                let resp = await dispatcher.dispatch(self.listener, conn, request, handled + 1 < keepalive_limit);
                _ = await conn.send(resp);
                logger.write_access(self.listener, conn, request, resp);
                handled += 1;
                if !dispatcher.keep_alive {
                    open = false;
                }
            }
        }
        _ = conn.close();
        return handled;
    }

    // Accept loop for one worker. Connections are handled inline to avoid
    // keeping short-lived client futures in a generic runtime container across
    // TLS close/reload races.
    async func worker_loop(self: web_server.ServerListener, max_requests: Int, logger: web_server.WebLogger) -> Int {
        let util = new web_server.ServerUtil();
        let accepted = 0;
        let serving = true;
        let accept_timeout_ms = DEFAULT_ACCEPT_TIMEOUT_MS;
        if self.is_tls {
            accept_timeout_ms = util.cfg_int(self.listener, "ssl_handshake_timeout_ms", DEFAULT_KEEPALIVE_TIMEOUT_MS);
            if accept_timeout_ms < DEFAULT_ACCEPT_TIMEOUT_MS {
                accept_timeout_ms = DEFAULT_ACCEPT_TIMEOUT_MS;
            }
        }
        loop serving {
            let cfd, _ = await self.accept(accept_timeout_ms);
            if cfd > 0 {
                _ = await (new web_server.ClientRequestTask()).handle(self.listener, self.is_tls, cfd, logger);
                accepted += 1;
            }
            if max_requests > 0 && accepted >= max_requests {
                serving = false;
            }
        }
        return 0;
    }

    // Opens the listener if needed and starts the worker loop.
    async func serve_open(self: web_server.ServerListener, max_requests: Int) -> Int {
        let util = new web_server.ServerUtil();
        if self.listen_fd <= 0 {
            self.listen_fd = util.cfg_int(self.listener, "__listen_fd", 0);
        }
        if self.listen_fd <= 0 {
            return 10;
        }
        self.is_tls = util.cfg_get(self.listener, "__is_tls", "0") == "1";
        let logger = new web_server.WebLogger();
        return await self.worker_loop(max_requests, logger);
    }
}

// Full application lifecycle: build plan, open listeners, start workers, and
// close resources when serving finishes.
class WebServerApplication {
    // Parsed global config.
    var cfg: collections.Map<String, String>;
    // Optional request limit for tests or controlled runs.
    var max_requests: Int;
    // Worker count captured before listener planning mutates transient config keys.
    var worker_processes: Int;
    // Runtime listener/vhost plan.
    var plan: web_server.ListenerPlan;

    func init(self: web_server.WebServerApplication, cfg: collections.Map<String, String>, max_requests: Int) -> Void {
        self.cfg = cfg;
        self.max_requests = max_requests;
        self.worker_processes = (new web_server.ServerUtil()).cfg_int(cfg, "worker_processes", 1);
        if self.worker_processes < 1 {
            self.worker_processes = 1;
        }
        self.plan = new web_server.ListenerPlan();
    }

    // Opens all listener sockets before workers start.
    func open_listeners(self: web_server.WebServerApplication) -> Int {
        let util = new web_server.ServerUtil();
        _ = self.plan.build(self.cfg);
        let started = 0;
        if self.plan.shared_vhosts > 0 {
            print("egret-web-server: grouped virtual hosts on shared listen sockets");
        }
        loop (let li = 0; li < self.plan.listener_count; li += 1) {
            let listener = self.plan.load_listener(li);
            _ = listener.pin();
            let open_err = (new web_server.ServerListener(listener)).open();
            if open_err != OK {
                print(
                "egret-web-server: failed to open listener "
                + util.cfg_get(listener, "listen_host", DEFAULT_LISTEN_HOST)
                + ":"
                + util.cfg_get(listener, "listen_port", DEFAULT_LISTEN_PORT_TEXT)
                + " https="
                + util.cfg_get(listener, "https_enabled", "0")
                + " err="
                + util.itoa(open_err)
                );
                _ = self.close_listeners();
                return -1;
            }
            _ = self.plan.save_listener(li, listener);
            started += 1;
        }
        return started;
    }

    // Closes every opened listener.
    func close_listeners(self: web_server.WebServerApplication) -> Void {
        loop (let i = 0; i < self.plan.listener_count; i += 1) {
            (new web_server.ServerListener(self.plan.load_listener(i))).close();
        }
    }

    // Starts listener workers concurrently without storing Future objects in a
    // generic container. Each Future stays in its own async frame, which avoids
    // the GC-sensitive Vector<Future(Int)> path seen on multi-listener workers.
    async func run_worker_listener_chain(self: web_server.WebServerApplication, li: Int) -> Int {
        if li >= self.plan.listener_count {
            return 0;
        }
        let worker_listener = self.plan.load_listener(li);
        _ = worker_listener.pin();
        let listener = new web_server.ServerListener(worker_listener);
        let current = spawn listener.serve_open(self.max_requests);
        let next = spawn self.run_worker_listener_chain(li + 1);
        let current_rc = join current;
        let next_rc = join next;
        if current_rc != 0 {
            return current_rc;
        }
        return next_rc;
    }

    // Runs one worker set in the current process.
    async func run_worker_set(self: web_server.WebServerApplication) -> Int {
        return await self.run_worker_listener_chain(0);
    }

    // Runs one child worker process and exits the child after cleanup.
    async func run_child_worker(self: web_server.WebServerApplication) -> Int {
        let child_rc = await self.run_worker_set();
        _ = self.close_listeners();
        _ = aio.fs.shutdown();
        _ = os.exit(child_rc);
        return child_rc;
    }

    // Forks one real worker for a configured slot. The master keeps listener
    // descriptors open so later replacement workers can inherit them.
    async func fork_worker_slot(self: web_server.WebServerApplication, slot: Int) -> Int, ErrCode {
        let pid, fork_err = os.fork();
        if fork_err != OK {
            print("egret-web-server: failed to fork worker slot " + (new web_server.ServerUtil()).itoa(slot));
            return -1, fork_err;
        }
        if pid == 0 {
            let child_rc = await self.run_child_worker();
            return child_rc, OK;
        }
        return pid, OK;
    }

    // Finds the worker slot for an exited pid.
    func find_worker_slot(self: web_server.WebServerApplication, pids: collections.Vector<Int>, pid: Int) -> Int {
        loop (let i = 0; i < pids.len(); i += 1) {
            if pids.get_unchecked(i) == pid {
                return i;
            }
        }
        return -1;
    }

    // Serves using forked worker processes when configured, otherwise runs the
    // worker set in the current process.
    async func serve(self: web_server.WebServerApplication) -> Int {
        let started = self.open_listeners();
        if started <= 0 {
            return 10;
        }
        let workers = self.worker_processes;
        let pids = new collections.Vector<Int>();
        let can_fork = workers > 1;
        if can_fork {
            loop (let wi = 0; wi < workers; wi += 1) {
                let pid, fork_err = await self.fork_worker_slot(wi);
                if fork_err != OK {
                    _ = self.close_listeners();
                    _ = aio.fs.shutdown();
                    return 1;
                }
                _ = pids.push(pid);
            }
            let rc = 0;
            let running = true;
            loop running {
                let exited_pid, wait_err = os.wait_any_pid();
                let st = os.wait_any_status();
                if wait_err != OK {
                    rc = 1;
                    running = false;
                } else {
                    let slot = self.find_worker_slot(pids, exited_pid);
                    if slot < 0 {
                        print("egret-web-server: unknown child " + (new web_server.ServerUtil()).itoa(exited_pid) + " exited with status " + (new web_server.ServerUtil()).itoa(st));
                    } else if self.max_requests > 0 {
                        _ = pids.set(slot, 0);
                        if st != 0 {
                            rc = st;
                        }
                        let remaining = 0;
                        loop (let pi = 0; pi < pids.len(); pi += 1) {
                            if pids.get_unchecked(pi) > 0 {
                                remaining += 1;
                            }
                        }
                        if remaining == 0 {
                            running = false;
                        }
                    } else {
                        if st != 0 {
                            print("egret-web-server: worker slot " + (new web_server.ServerUtil()).itoa(slot) + " exited with status " + (new web_server.ServerUtil()).itoa(st) + "; respawning");
                        }
                        let next_pid, next_err = await self.fork_worker_slot(slot);
                        if next_err != OK {
                            rc = 1;
                            running = false;
                        } else {
                            _ = pids.set(slot, next_pid);
                        }
                    }
                }
            }
            _ = self.close_listeners();
            _ = aio.fs.shutdown();
            return rc;
        }
        let rc = await self.run_worker_set();
        _ = self.close_listeners();
        _ = aio.fs.shutdown();
        return rc;
    }
}

// Parsed command-line options for WebServerCli.
class RunOptions {
    // Config file path.
    var config_path: String;
    // True for config validation only.
    var check_config: Bool;
    // True when startup should print memory/listener stats.
    var memory_stats: Bool;
    // Optional maximum number of accepted requests.
    var max_requests: Int;
    // True when help was requested.
    var help: Bool;
    // False when argv parsing found an invalid option.
    var ok: Bool;

    func init(self: web_server.RunOptions) -> Void {
        self.config_path = "";
        self.check_config = false;
        self.memory_stats = false;
        self.max_requests = 0;
        self.help = false;
        self.ok = true;
    }

    // Parses supported CLI flags and records invalid input in ok.
    func parse(self: web_server.RunOptions, argc: Int, argv: Int) -> Void {
        let util = new web_server.ServerUtil();
        if argc <= 1 {
            self.help = true;
            return;
        }
        let i = 1;
        loop i < argc {
            let a = argv_get(argc, argv, i);
            let has_next = i + 1 < argc;
            match a {
                "-h" => {
                    self.help = true;
                    return;
                },
                "--help" => {
                    self.help = true;
                    return;
                },
                "-c" => {
                    if has_next {
                        self.config_path = argv_get(argc, argv, i + 1);
                        i += 2;
                    } else {
                        self.ok = false;
                        return;
                    }
                },
                "--check-config" => {
                    self.check_config = true;
                    i += 1;
                },
                "--memory-stats" => {
                    self.memory_stats = true;
                    i += 1;
                },
                "--max-requests" => {
                    if has_next {
                        self.max_requests = util.atoi_or(argv_get(argc, argv, i + 1), 0);
                        i += 2;
                    } else {
                        self.ok = false;
                        return;
                    }
                },
                _ => {
                    self.ok = false;
                    return;
                }
            }
        }
        if len(self.config_path) == 0 {
            self.ok = false;
        }
    }
}

// Runtime tuning hooks.
class ServerRuntime {
    func init(self: web_server.ServerRuntime) -> Void {
    }

    // Sets an adaptive GC ceiling suitable for long-running server workloads.
    func configure_gc(self: web_server.ServerRuntime) -> Void {
        _ = runtime.gc_set_threshold(DEFAULT_GC_MAX_ADAPTIVE_THRESHOLD_BYTES);
        _ = runtime.gc_set_max_adaptive_threshold_bytes(DEFAULT_GC_MAX_ADAPTIVE_THRESHOLD_BYTES);
        _ = runtime.gc_set_interval_ms(0);
    }
}

// Command-line facade for the executable.
class WebServerCli {
    func init(self: web_server.WebServerCli) -> Void {
    }

    // Prints command usage.
    func print_help(self: web_server.WebServerCli) -> Void {
        print("egret-web-server: A powerful and high-performance web server using egret-lang. Powered by egret-lang.org");
        print("Usage:");
        print("  egret-web-server -c <config> [--check-config] [--memory-stats] [--max-requests <n>]");
        print("  egret-web-server -h");
        print(" ");
        print("Options:");
        print("  -c <config>        Path to nginx-style config file.");
        print("  --check-config     Parse and print config summary, then exit.");
        print("  --memory-stats     Materialize listener config, pin it, and print memory stats.");
        print("  --max-requests n   Stop after accepting n requests. Useful for tests.");
        print("  -h, --help         Print this help message.");
        print(" ");
        print("Examples:");
        print("  egret-web-server -c examples/egret-web-server/conf/web.conf");
        print("  egret-web-server -c examples/egret-web-server/conf/web.conf --check-config");
        print("  egret-web-server -c examples/egret-web-server/conf/https.conf --max-requests 1");
    }

    // Prints derived listener stats and basic runtime memory usage.
    func print_memory_stats(self: web_server.WebServerCli, cfg: collections.Map<String, String>) -> Void {
        let util = new web_server.ServerUtil();
        let plan = new web_server.ListenerPlan();
        _ = plan.build(cfg);
        loop (let li = 0; li < plan.listener_count; li += 1) {
            let listener = plan.load_listener(li);
            _ = listener.pin();
            _ = plan.save_listener(li, listener);
        }
        print("EGRET_WEB_SERVER_MEMORY_STATS");
        print("  listener_count: " + util.itoa(plan.listener_count));
        print("  shared_vhosts: " + util.itoa(plan.shared_vhosts));
        print("  map_ss_pinned_count: " + util.itoa(runtime.map_ss_pinned_count()));
        print("  map_ss_pinned_entries: " + util.itoa(runtime.map_ss_pinned_entries()));
        print("  map_ss_pinned_bytes: " + util.itoa(runtime.map_ss_pinned_bytes()));
        print("  gc_native_bytes: " + util.itoa(runtime.gc_native_bytes()));
        print("  gc_effective_heap_bytes: " + util.itoa(runtime.gc_effective_heap_bytes()));
    }

    // Parses options, loads config, optionally checks it, and starts serving.
    async func run(self: web_server.WebServerCli, argc: Int, argv: Int) -> Int {
        let opts = new web_server.RunOptions();
        _ = opts.parse(argc, argv);
        if opts.help {
            _ = self.print_help();
            return 0;
        }
        if !opts.ok {
            _ = self.print_help();
            return 1;
        }
        let cfg, cfg_err = (new web_server.ConfigLoader()).load(opts.config_path);
        if cfg_err != OK {
            return 2;
        }
        if opts.check_config {
            let wrapped = new web_server.ServerConfig(cfg);
            print(wrapped.summary());
            return 0;
        }
        if opts.memory_stats {
            _ = self.print_memory_stats(cfg);
            return 0;
        }
        (new web_server.ServerRuntime()).configure_gc();
        return await (new web_server.WebServerApplication(cfg, opts.max_requests)).serve();
    }
}
