// Process entry point for the egret-web-server executable.
// The real CLI and server lifecycle live in web_server.WebServerCli so the
// top-level file stays small and only wires argv into the web_server module.
use web_server;

// Starts the web server CLI and returns its process exit code.
async func main(argc: Int, argv: Int) -> Int {
    return await (new web_server.WebServerCli()).run(argc, argv);
}
